{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "pages/**",
        "games/**",
        "shared/**",
        "favicon.ico",
        "upload/**",
        "*.png",
        "*.svg",
        "*.webmanifest"
      ]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}

